---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cacheFor, getSubstackPosts } from "../../lib/substack";

cacheFor(Astro);
let posts = [];
try { posts = await getSubstackPosts(); } catch { /* Render a helpful page while Substack is unavailable. */ }
const years = [...new Set(posts.map((post) => post.publishedAt.getUTCFullYear()))];
---

<BaseLayout title="Writing" description="Essays and notes by Nikhil Reddy">
  <main id="main" role="main" class="layout-writing"><article class="page writing-page"><div class="page__inner-wrap">
    <header><h1 class="page__title"><a href="/" class="writing-back-link">&lt;&lt;</a></h1></header>
    <div id="writing-list-root">
      {posts.length ? years.map((year) => <section class="writing-year-group"><h2 class="writing-year-heading">'{String(year).slice(-2)}</h2><ul class="writing-items">{posts.filter((post) => post.publishedAt.getUTCFullYear() === year).map((post) => <li>{post.title} [<a href={`/writing/${post.slug}/`}>link</a>]</li>)}</ul></section>) : <p>Writing is temporarily unavailable. Please try again shortly.</p>}
    </div>
  </div></article></main>
</BaseLayout>
